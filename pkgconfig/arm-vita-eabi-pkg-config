#!/usr/bin/env bash

: "${VITASDK:?VITASDK is not set}"

backend="${VITASDK}/bin/pkgconf"
if [[ ! -x "${backend}" ]]; then
  if command -v pkgconf >/dev/null 2>&1; then
    backend="$(command -v pkgconf)"
  elif command -v pkg-config >/dev/null 2>&1; then
    backend="$(command -v pkg-config)"
  else
    echo >&2 "arm-vita-eabi-pkg-config: pkg-config is not installed. Aborting."
    exit 127
  fi
fi

# Remove host pkg-config settings instead of exporting empty values: pkgconf
# treats the presence of PKG_CONFIG_MSVC_SYNTAX as enabling MSVC output.

unset PKG_CONFIG_DIR PKG_CONFIG_PATH PKG_CONFIG_SYSROOT_DIR \
  PKG_CONFIG_PRELOADED_FILES PKG_CONFIG_MSVC_SYNTAX \
  PKG_CONFIG_SYSTEM_INCLUDE_PATH PKG_CONFIG_SYSTEM_LIBRARY_PATH

export PKG_CONFIG_LIBDIR="${VITASDK}/arm-vita-eabi/lib/pkgconfig:${VITASDK}/arm-vita-eabi/share/pkgconfig"

[[ "${1-}" == '--version' ]] && exec "${backend}" --version
exec "${backend}" "--define-variable=VITASDK=${VITASDK}" --define-prefix --static "$@"
